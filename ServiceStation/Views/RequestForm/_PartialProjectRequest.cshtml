                                @if (item.Code == "OTHER")
                                {
                                    <input class="inp inline form-control form-control-sm"
                                           type="text"
                                           id="txtPTypeOther"
                                           asp-for="_Viewsvsps_project_request.pt_other_text"
                                           placeholder="กรุณาระบุ..."
                                           style="width:200px; display:@(isOtherChecked ? "inline-block" : "none"); margin-top:5px;" />
                                }
                            </label>
                        </div>
                    }
                </div>
            }

