            <input type="hidden" asp-for="_Viewsvsps_project_request.project_types" id="textproject_types" style="width:100%">

            @{
                var projectTypes = (Model._Viewsvsps_project_request.project_types ?? "")
                    .Split('|', StringSplitOptions.RemoveEmptyEntries)
                    .Select(x => x.Trim())
                    .ToList();

                var isOtherChecked = projectTypes.Contains("OTHER");
            }

            @foreach (var group in Model.ListLookupGroupViewModel.Where(x => x.CategoryCode == "PROJECT_TYPE"))
            {
                <div class="row" style="margin-left:10px">
                    @foreach (var item in group.Items)
                    {
                        <div class="col-md-2 mb-3">
                            <label class="form-check">
                                <!-- เพิ่ม class="project-type-checkbox" และ data-code="@item.Code" เพื่อให้ JS รู้จัก -->
                                <input type="checkbox"
                                       class="form-check-input project-type-checkbox"
                                       name="lookup_@group.CategoryCode"
                                       value="@item.Code"
                                       data-code="@item.Code"
                                       @(projectTypes.Contains(item.Code) ? "checked" : "") />

                                <span class="form-check-label" style="margin-left:5px">
                                    @item.NameTH
