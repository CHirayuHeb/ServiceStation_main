                <label><input type="checkbox" asp-for="_ViewsvsServiceProject.prPType_Automation"> Automation</label>
                <label><input type="checkbox" asp-for="_ViewsvsServiceProject.prPType_AI"> AI</label>
                <label><input type="checkbox" asp-for="_ViewsvsServiceProject.prPType_IoT"> IoT</label>
